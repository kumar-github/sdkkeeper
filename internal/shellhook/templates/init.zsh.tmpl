sk() {
    # --format=json is checked anywhere in the argument list, not just
    # $1, and always takes the plain, non-eval branch below -- it must
    # never reach eval, since it's a report, not a shell action, and
    # `sk use --format=json ...` (flag after the subcommand) would
    # otherwise eval sk's raw JSON output as shell code.
    local arg has_format=0
    for arg in "$@"; do
        if [[ "$arg" == "--format" || "$arg" == --format=* ]]; then
            has_format=1
            break
        fi
    done
    if [[ "$has_format" -eq 0 && ( "$1" == "use" || "$1" == "remove" ) ]]; then
        eval "$(command sk "$@")"
    else
        command sk "$@"
    fi
}
