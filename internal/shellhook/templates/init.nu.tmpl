def --env sk [
    # Declared explicitly: Nushell's parser rejects any --flag token
    # passed to a custom command unless the signature declares it, at
    # parse time, before the function body runs. Declaring it here
    # also means Nushell's own flag parsing extracts it correctly no
    # matter where it appears among the other arguments.
    --format: string,
    ...args
] {
    # Nushell's parser converts a bare, unquoted `null` word into its
    # own `nothing` type, not the string "null" -- so `sk use java
    # null` needs mapping back to the literal string here before
    # anything else touches $args.
    let args = ($args | each {|a| if ($a == null) { "null" } else { $a } })

    if ($format != null) {
        # --format=json is a report, never a shell action, so it must
        # always be a plain passthrough, never eval/--shell-format=json.
        ^sk --format $format ...$args
    } else if ($args | length) >= 1 and (($args | get 0) == "use" or ($args | get 0) == "remove") {
        let result = (^sk ...$args --shell-format=json | complete)
        # `| complete` captures both stdout and stderr; without this,
        # every human-readable status/error message sk prints (e.g.
        # "No JDK versions found to use.") was silently discarded.
        if ($result.stderr | str trim | is-not-empty) {
            print -e ($result.stderr | str trim)
        }
        let out = ($result.stdout | str trim)
        if ($out | is-not-empty) {
            let data = ($out | from json)
            for key in ($data | columns) {
                if $key == "unset" {
                    # load-env with a null value, not hide-env: hide-env
                    # silently fails to persist when another $env
                    # mutation happens in the same --env call, which
                    # this wrapper also does (PATH) whenever
                    # deactivating. A null-valued env var is correctly
                    # omitted from what a spawned process sees.
                    for name in ($data | get unset) {
                        load-env {($name): null}
                    }
                } else if $key == "path_remove" {
                    # `sk use` prepends a version's bin directory each
                    # time but never removes an earlier prepend for a
                    # different version, so PATH could still resolve
                    # to a stale entry after switching/removing.
                    for dir in ($data | get path_remove) {
                        $env.PATH = ($env.PATH | where $it != $dir)
                    }
                } else if $key != "PATH_PREPEND" and $key != "PATH_STRIP_PREFIXES" {
                    load-env {($key): ($data | get $key)}
                }
            }
            if "PATH_STRIP_PREFIXES" in ($data | columns) {
                # Filters by prefix, not exact match, so at most one
                # entry per tool ever persists on PATH regardless of
                # which version it was -- fixes unbounded PATH growth
                # from repeated/switched activation.
                let prefixes = ($data | get PATH_STRIP_PREFIXES)
                $env.PATH = ($env.PATH | where {|it| not ($prefixes | any {|p| $it | str starts-with $p }) })
            }
            if "PATH_PREPEND" in ($data | columns) {
                let dirs = ($data | get PATH_PREPEND | split row ":")
                $env.PATH = ($dirs | append $env.PATH)
            }
        }
    } else {
        ^sk ...$args
    }
}
