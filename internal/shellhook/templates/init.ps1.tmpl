function sk {
    # --format=json is checked anywhere in $args, not just $args[0],
    # and always takes the plain passthrough branch below -- it must
    # never reach Invoke-Expression, since it's a report, not a shell
    # action, and `sk use --format=json ...` (flag after the
    # subcommand) would otherwise Invoke-Expression sk's raw JSON.
    $hasFormat = $false
    foreach ($a in $args) {
        if ($a -eq "--format" -or $a -like "--format=*") {
            $hasFormat = $true
            break
        }
    }
    if (-not $hasFormat -and $args.Count -ge 1 -and ($args[0] -eq "use" -or $args[0] -eq "remove")) {
        # sk.exe, with the extension, bypasses this function (named
        # "sk") to reach the real binary on PATH.
        $output = & sk.exe @args --shell-format=powershell
        if ($output) {
            # Joined into one string so a multi-line PowerShell-format
            # output (e.g. the PATH-deduplication block) executes as
            # one unit, the same as zsh's own eval "$(...)".
            Invoke-Expression ($output -join "`n")
        }
    } else {
        & sk.exe @args
    }
}
